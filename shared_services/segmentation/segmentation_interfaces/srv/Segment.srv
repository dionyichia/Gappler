# One frame and one prompt in, every object SAM 3 found out. The service keeps nothing
# between calls apart from the loaded model.

# ---- Request ----
sensor_msgs/Image      image          # rgb8 or bgr8. header.frame_id = the camera's optical frame
string                 prompt         # object words, e.g. "box". Empty = error
sensor_msgs/Image      depth          # OPTIONAL. Aligned to image, same size. 16UC1 (mm) or 32FC1 (m).
                                      #   width 0 = no depth
sensor_msgs/CameraInfo camera_info    # OPTIONAL. Needed for the 3D point. All-zero K = none
float32                min_score      # 0 = service default (config, today 0.5)
uint8                  max_detections # 0 = service default (config)
---
# ---- Response ----
bool                   success
string                 message        # reason when success is false
std_msgs/Header        header         # copied from the request image: same stamp, same frame_id
Detection[]            detections     # sorted by score, best first. May be empty
float32                inference_ms
