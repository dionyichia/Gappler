{
  "configById": {
    "Tab!views": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "Main",
          "layout": {
            "direction": "row", "splitPercentage": 55,
            "first": {"direction": "column", "splitPercentage": 70,
                      "first": "StateTransitions!timeline", "second": "RosOut!mainlog"},
            "second": {"direction": "column", "first": "Image!mainwrist", "second": "Image!mainaria"}
          }
        },
        {
          "title": "Grasp",
          "layout": {
            "direction": "row", "splitPercentage": 55,
            "first": {"direction": "column", "splitPercentage": 60,
                      "first": "Image!graspwrist",
                      "second": {"direction": "row", "first": "Plot!depth", "second": "Plot!score"}},
            "second": {"direction": "column", "splitPercentage": 25,
                       "first": "StateTransitions!grasptimeline",
                       "second": {"direction": "column", "first": "Image!mask", "second": "3D!arm"}}
          }
        },
        {
          "title": "Glasses",
          "layout": {
            "direction": "row", "splitPercentage": 65,
            "first": "Image!glassesaria",
            "second": {"direction": "column", "first": "RawMessages!target", "second": "RawMessages!gaze"}
          }
        },
        {
          "title": "Nav",
          "layout": {
            "direction": "row", "splitPercentage": 70,
            "first": "3D!nav",
            "second": {"direction": "column", "first": "Plot!cmdvel", "second": "StateTransitions!navevents"}
          }
        },
        {
          "title": "Topics",
          "layout": "SourceInfo!topics"
        }
      ]
    },
    "StateTransitions!timeline": {
      "paths": [
        {"value": "/pipeline_state.data", "label": "state machine", "timestampMethod": "receiveTime"},
        {"value": "/aria/audio/prompt.data", "label": "voice word", "timestampMethod": "receiveTime"},
        {"value": "/grasp/target.prompt", "label": "target sent", "timestampMethod": "receiveTime"},
        {"value": "/goal_reached.data", "label": "nav arrived", "timestampMethod": "receiveTime"},
        {"value": "/manipulation/start.data", "label": "handover start", "timestampMethod": "receiveTime"},
        {"value": "/manipulator/return_to_user.data", "label": "return to user", "timestampMethod": "receiveTime"},
        {"value": "/manipulator/release.data", "label": "release", "timestampMethod": "receiveTime"}
      ]
    },
    "RosOut!mainlog": {"minLogLevel": 3, "searchTerms": []},
    "Image!mainwrist": {"imageMode": {"imageTopic": "/camera/camera/color/image_raw/compressed"}},
    "Image!mainaria": {"imageMode": {"imageTopic": "/aria/rgb_camera/raw"}},
    "Image!graspwrist": {
      "imageMode": {
        "imageTopic": "/camera/camera/color/image_raw/compressed",
        "calibrationTopic": "/camera/camera/color/camera_info"
      },
      "topics": {
        "/grasp_candidate_markers": {"visible": true},
        "/debug/anygrasp_points": {"visible": true},
        "/debug/centroid_marker": {"visible": true}
      }
    },
    "Plot!depth": {
      "minYValue": 0,
      "maxYValue": 0.7,
      "paths": [
        {"value": "/object_centroid_2d.point.z", "enabled": true, "timestampMethod": "receiveTime",
         "label": "depth to object (m), SELECTING stops at 0.18"}
      ]
    },
    "Plot!score": {
      "minYValue": 0,
      "maxYValue": 1,
      "paths": [
        {"value": "/grasp_candidates.grasps[0].score", "enabled": true, "timestampMethod": "receiveTime",
         "label": "best grasp score"}
      ]
    },
    "StateTransitions!grasptimeline": {
      "paths": [
        {"value": "/pipeline_state.data", "label": "state machine", "timestampMethod": "receiveTime"},
        {"value": "/grasp/target.prompt", "label": "target sent", "timestampMethod": "receiveTime"}
      ]
    },
    "Image!mask": {"imageMode": {"imageTopic": "/debug/sam_mask"}},
    "3D!arm": {
      "followTf": "base_link",
      "layers": {"grid": {"layerId": "foxglove.Grid", "visible": true}},
      "topics": {
        "/robot_description": {"visible": true},
        "/debug/anygrasp_points": {"visible": true},
        "/grasp_candidate_markers": {"visible": true},
        "/debug/centroid_marker": {"visible": true},
        "/debug/state_marker": {"visible": true},
        "/object_centroid": {"visible": true},
        "/manipulation/goal_pose": {"visible": true}
      }
    },
    "Image!glassesaria": {"imageMode": {"imageTopic": "/aria/rgb_camera/raw"}},
    "RawMessages!target": {"topicPath": "/grasp/target.prompt"},
    "RawMessages!gaze": {"topicPath": "/aria/eye_tracking/gaze_estimate"},
    "3D!nav": {
      "followTf": "map",
      "layers": {"grid": {"layerId": "foxglove.Grid", "visible": true}},
      "topics": {
        "/base/robot_description": {"visible": true},
        "/map": {"visible": true},
        "/global_costmap/costmap": {"visible": true, "colorMode": "costmap"},
        "/plan": {"visible": true},
        "/scan": {"visible": true},
        "/livox/lidar": {"visible": false},
        "/robot_pose": {"visible": true},
        "/goal_pose": {"visible": true},
        "/aria/fused_pose": {"visible": true},
        "/object_marker": {"visible": true},
        "/aria/glasses_marker": {"visible": true}
      }
    },
    "Plot!cmdvel": {
      "paths": [
        {"value": "/cmd_vel.linear.x", "enabled": true, "timestampMethod": "receiveTime", "label": "forward (m/s)"},
        {"value": "/cmd_vel.angular.z", "enabled": true, "timestampMethod": "receiveTime", "label": "turn (rad/s)"}
      ]
    },
    "StateTransitions!navevents": {
      "paths": [
        {"value": "/goal_reached.data", "label": "nav arrived", "timestampMethod": "receiveTime"},
        {"value": "/manipulation/start.data", "label": "handover start", "timestampMethod": "receiveTime"}
      ]
    },
    "SourceInfo!topics": {}
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {"speed": 1},
  "layout": "Tab!views"
}
