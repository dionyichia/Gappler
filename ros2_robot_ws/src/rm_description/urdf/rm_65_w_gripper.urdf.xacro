<?xml version="1.0" encoding="utf-8"?>
<robot name="rm_65_with_gripper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find rm_description)/urdf/rm_65.urdf.xacro" />
  <xacro:include filename="$(find rm_description)/urdf/eg2_4b_description_patch.urdf" />
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />

  <joint name="gripper_attach" type="fixed">
    <parent link="Link6" />
    <child link="gripper_base_link" />
    <origin xyz="0 0 0.004" rpy="0 0 1.5708" />
  </joint>

  <!-- Link to camera tf_tree, past offset <origin xyz="0.014 -0.0125 0.0475" rpy="0 0 0" />-->
  <xacro:sensor_d435 parent="Link6" name="camera" use_nominal_extrinsics="false">
    <origin xyz="-0.0125 0.0475 0.014" rpy="0 -1.5708 -1.5708" />
  </xacro:sensor_d435>

</robot>